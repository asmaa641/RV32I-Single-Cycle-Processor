`timescale 1ns/1ps

module Processor_Ms2_tb;

  reg clk = 0, rst = 1;
  integer pass_count = 0, fail_count = 0;

  Processor DUT(.clk(clk), .rst(rst));

  always #5 clk = ~clk;

  task reset_cpu;
    begin
      rst = 1;
      #12;
      rst = 0;
      #1;
    end
  endtask

  task check_reg(input [31:0] ins, input [31:0] exp, input [8*16-1:0] nm);
    begin
      DUT.im.mem[0] = ins;
      reset_cpu();

      force DUT.register.q[1] = 32'd10;
      force DUT.register.q[2] = 32'd3;

      @(posedge clk);
      #1;

      if (DUT.register.q[3] === exp) begin
        $display("PASS %0s x3=%h", nm, DUT.register.q[3]);
        pass_count = pass_count + 1;
      end
      else begin
        $display("FAIL %0s expected=%h actual=%h", nm, exp, DUT.register.q[3]);
        fail_count = fail_count + 1;
      end

      release DUT.register.q[1];
      release DUT.register.q[2];
      #1;
    end
  endtask

  task check_load(input [31:0] ins, input [31:0] exp, input [8*16-1:0] nm);
    begin
      DUT.im.mem[0] = ins;
      DUT.DataMem.mem[0] = 32'h80000003;
      reset_cpu();

      force DUT.register.q[1] = 32'd0;

      @(posedge clk);
      #1;

      if (DUT.register.q[3] === exp) begin
        $display("PASS %0s x3=%h", nm, DUT.register.q[3]);
        pass_count = pass_count + 1;
      end
      else begin
        $display("FAIL %0s expected=%h actual=%h", nm, exp, DUT.register.q[3]);
        fail_count = fail_count + 1;
      end

      release DUT.register.q[1];
      #1;
    end
  endtask

  task check_branch(input [31:0] ins, input [31:0] exp_pc, input [8*16-1:0] nm);
    begin
      DUT.im.mem[0] = ins;
      reset_cpu();

      force DUT.register.q[1] = 32'd10;
      force DUT.register.q[2] = 32'd3;

      @(posedge clk);
      #1;

      if (DUT.pcout === exp_pc) begin
        $display("PASS %0s PC=%h", nm, DUT.pcout);
        pass_count = pass_count + 1;
      end
      else begin
        $display("FAIL %0s expected PC=%h actual=%h", nm, exp_pc, DUT.pcout);
        fail_count = fail_count + 1;
      end

      release DUT.register.q[1];
      release DUT.register.q[2];
      #1;
    end
  endtask

  task check_store(input [31:0] ins, input [31:0] exp_mem, input [8*16-1:0] nm);
    begin
      DUT.im.mem[0] = ins;
      DUT.DataMem.mem[0] = 32'hAABBCCDD;
      reset_cpu();

      force DUT.register.q[1] = 32'd0;
      force DUT.register.q[2] = 32'd3;

      @(posedge clk);
      #1;

      if (DUT.DataMem.mem[0] === exp_mem) begin
        $display("PASS %0s mem=%h", nm, DUT.DataMem.mem[0]);
        pass_count = pass_count + 1;
      end
      else begin
        $display("FAIL %0s expected mem=%h actual=%h", nm, exp_mem, DUT.DataMem.mem[0]);
        fail_count = fail_count + 1;
      end

      release DUT.register.q[1];
      release DUT.register.q[2];
      #1;
    end
  endtask

  initial begin

    // R-type
    check_reg(32'h002081B3, 13, "ADD");
    check_reg(32'h402081B3, 7, "SUB");
    check_reg(32'h002091B3, 80, "SLL");
    check_reg(32'h0020A1B3, 0, "SLT");
    check_reg(32'h0020B1B3, 0, "SLTU");
    check_reg(32'h0020C1B3, 9, "XOR");
    check_reg(32'h0020D1B3, 1, "SRL");
    check_reg(32'h4020D1B3, 1, "SRA");
    check_reg(32'h0020E1B3, 11, "OR");
    check_reg(32'h0020F1B3, 2, "AND");

    // I-type
    check_reg(32'h00508193, 15, "ADDI");
    check_reg(32'h0050A193, 0, "SLTI");
    check_reg(32'h0050B193, 0, "SLTIU");
    check_reg(32'h0050C193, 15, "XORI");
    check_reg(32'h0050E193, 15, "ORI");
    check_reg(32'h0050F193, 0, "ANDI");
    check_reg(32'h00209193, 40, "SLLI");
    check_reg(32'h0020D193, 2, "SRLI");
    check_reg(32'h4020D193, 2, "SRAI");

    // Loads
    check_load(32'h00008183, 3, "LB");
    check_load(32'h00009183, 3, "LH");
    check_load(32'h0000A183, 32'h80000003, "LW");
    check_load(32'h0000C183, 3, "LBU");
    check_load(32'h0000D183, 3, "LHU");

    // Stores
    check_store(32'h00208023, 32'hAABBCC03, "SB");
    check_store(32'h00209023, 32'hAABB0003, "SH");
    check_store(32'h0020A023, 32'h00000003, "SW");

    // Branches
    check_branch(32'h00208463, 4, "BEQ");
    check_branch(32'h00209463, 8, "BNE");
    check_branch(32'h0020C463, 4, "BLT");
    check_branch(32'h0020D463, 8, "BGE");
    check_branch(32'h0020E463, 4, "BLTU");
    check_branch(32'h0020F463, 8, "BGEU");

    // JAL
    DUT.im.mem[0] = 32'h008001EF;
    reset_cpu();
    @(posedge clk);
    #1;

    if (DUT.register.q[3] === 4 && DUT.pcout === 8) begin
      pass_count = pass_count + 1;
      $display("PASS JAL");
    end
    else begin
      fail_count = fail_count + 1;
      $display("FAIL JAL x3=%h PC=%h", DUT.register.q[3], DUT.pcout);
    end

    // JALR
    DUT.im.mem[0] = 32'h000081E7;
    reset_cpu();
    force DUT.register.q[1] = 0;

    @(posedge clk);
    #1;

    if (DUT.register.q[3] === 4 && DUT.pcout === 0) begin
      pass_count = pass_count + 1;
      $display("PASS JALR");
    end
    else begin
      fail_count = fail_count + 1;
      $display("FAIL JALR x3=%h PC=%h", DUT.register.q[3], DUT.pcout);
    end

    release DUT.register.q[1];

    // U-type
    check_reg(32'h123451B7, 32'h12345000, "LUI");

    // AUIPC
    DUT.im.mem[0] = 32'h12345197;
    reset_cpu();

    force DUT.register.q[1] = 0;
    force DUT.register.q[2] = 0;

    @(posedge clk);
    #1;

    if (DUT.register.q[3] === 32'h12345000) begin
      pass_count = pass_count + 1;
      $display("PASS AUIPC");
    end
    else begin
      fail_count = fail_count + 1;
      $display("FAIL AUIPC x3=%h", DUT.register.q[3]);
    end

    release DUT.register.q[1];
    release DUT.register.q[2];

    // ECALL
    DUT.im.mem[0] = 32'h00000073;
    reset_cpu();
    @(posedge clk);
    #1;

    if (DUT.pcout === 4) begin
      pass_count = pass_count + 1;
      $display("PASS ECALL");
    end
    else begin
      fail_count = fail_count + 1;
      $display("FAIL ECALL");
    end

    // EBREAK
    DUT.im.mem[0] = 32'h00100073;
    reset_cpu();
    @(posedge clk);
    #1;

    if (DUT.pcout === 0) begin
      pass_count = pass_count + 1;
      $display("PASS EBREAK");
    end
    else begin
      fail_count = fail_count + 1;
      $display("FAIL EBREAK");
    end

    // FENCE
    DUT.im.mem[0] = 32'h0330000F;
    reset_cpu();
    @(posedge clk);
    #1;

    if (DUT.pcout === 4) begin
      pass_count = pass_count + 1;
      $display("PASS FENCE");
    end
    else begin
      fail_count = fail_count + 1;
      $display("FAIL FENCE");
    end

    // FENCE.TSO
    DUT.im.mem[0] = 32'h8330000F;
    reset_cpu();
    @(posedge clk);
    #1;

    if (DUT.pcout === 4) begin
      pass_count = pass_count + 1;
      $display("PASS FENCE.TSO");
    end
    else begin
      fail_count = fail_count + 1;
      $display("FAIL FENCE.TSO");
    end

    // PAUSE
    DUT.im.mem[0] = 32'h0100000F;
    reset_cpu();
    @(posedge clk);
    #1;

    if (DUT.pcout === 4) begin
      pass_count = pass_count + 1;
      $display("PASS PAUSE");
    end
    else begin
      fail_count = fail_count + 1;
      $display("FAIL PAUSE");
    end

    // Summary
    $display("--------------------------------");
    $display("MS2 SUMMARY: %0d PASS, %0d FAIL", pass_count, fail_count);

    if (fail_count == 0)
      $display("ALL TESTS PASSED");

    $finish;
  end

endmodule
